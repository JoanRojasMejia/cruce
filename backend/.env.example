# Copia este archivo como .env y llena los valores. El .env no se sube al repo.
PORT=8080
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Llave service_role: solo en el servidor, nunca en la app.
SUPABASE_SERVICE_ROLE_KEY=
# Secreto que también pones en el Database Webhook de Supabase (header Authorization: Bearer ...).
WEBHOOK_SECRET=
